# Required to run the agent (scripts/run_investigation.py, eval/run_eval.py).
# The MCP server and openFDA client work without this -- only the Claude
# tool-use loop needs it.
ANTHROPIC_API_KEY=

# Optional. Overrides the default model (claude-sonnet-5) if your account
# doesn't have access to it -- e.g. set to claude-sonnet-4-5-20250929.
ANTHROPIC_MODEL=

# Optional. openFDA works with no key at low rate limits; get a free one at
# https://open.fda.gov/apis/authentication/ if you hit 429s.
FDA_API_KEY=
